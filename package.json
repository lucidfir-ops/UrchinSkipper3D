{
  "name": "urchin-skipper-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5183",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5184",
    "test": "node --test",
    "start": "node scripts/serve-build.js",
    "lint": "eslint src scripts tests world-source --max-warnings 0",
    "format": "prettier --write \"src/**/*.js\" \"src/**/*.css\" \"scripts/**/*.js\" \"tests/*.js\" \"world-source/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"src/**/*.css\" \"scripts/**/*.js\" \"tests/*.js\" \"world-source/*.js\"",
    "verify": "node scripts/verify.js"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "vite": "7.3.6"
  }
}
